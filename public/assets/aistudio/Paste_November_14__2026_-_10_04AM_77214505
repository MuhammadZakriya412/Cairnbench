## 5. Data model (Postgres + RLS)

```sql
create extension if not exists citext;
create type org_role as enum ('owner','admin','member');
create type share_perm as enum ('view','edit');
create type review_status as enum ('open','approved','changes_requested');

create table profiles (
  id uuid primary key references auth.users on delete cascade,
  handle citext unique check (handle ~ '^[a-z0-9_]{3,30}$'),
  display_name text, avatar_url text,
  theme text not null default 'carbon-studio'
    check (theme in ('carbon-studio','alabaster-paper','cobalt-slate','warm-atelier')),
  density text not null default 'comfortable' check (density in ('comfortable','compact')),
  motion  text not null default 'fluid' check (motion in ('fluid','reduced')),
  default_launch text not null default 'preview' check (default_launch in ('preview','workspace')),
  redaction_rules jsonb not null default '{}',
  created_at timestamptz default now(), updated_at timestamptz default now()
);

create table organizations (
  id uuid primary key default gen_random_uuid(),
  name text not null, slug citext unique not null, description text,
  accent_color text check (accent_color ~ '^#[0-9a-fA-F]{6}$'),
  created_by uuid references profiles(id), created_at timestamptz default now()
);
create table organization_members (
  org_id uuid references organizations on delete cascade,
  user_id uuid references profiles on delete cascade,
  role org_role not null, created_at timestamptz default now(),
  primary key (org_id, user_id)
);
create table organization_invites (
  id uuid primary key default gen_random_uuid(),
  org_id uuid references organizations on delete cascade,
  email citext not null, role org_role not null default 'member',
  token_hash text not null, invited_by uuid references profiles,
  expires_at timestamptz not null, accepted_at timestamptz
);

create table vault_items (
  id uuid primary key default gen_random_uuid(),           -- client may supply (import idempotency)
  owner_id uuid not null references profiles(id),
  org_id uuid references organizations(id),                 -- null = personal
  app_id text not null check (app_id in
    ('context-packer','api-runner','log-regex-explorer','prompt-composer','mcp-hub')),
  title text not null check (length(title) <= 200),
  summary text,
  content jsonb not null check (pg_column_size(content) <= 524288),   -- 512 KB (see §17)
  tags text[] not null default '{}',
  is_encrypted boolean not null default false,
  enc_meta jsonb,                                           -- {alg,kdf,iter,salt,iv}; no key material ever
  version int not null default 1,
  created_at timestamptz default now(), updated_at timestamptz default now(),
  deleted_at timestamptz                                    -- soft delete (30-day purge job)
);
create index on vault_items (owner_id) where deleted_at is null;
create index on vault_items (org_id)   where deleted_at is null;
create index on vault_items using gin (tags);

create table vault_item_versions (
  item_id uuid references vault_items on delete cascade,
  version int, content jsonb not null, edited_by uuid references profiles,
  created_at timestamptz default now(), primary key (item_id, version)
);
create table vault_shares (
  id uuid primary key default gen_random_uuid(),
  item_id uuid not null references vault_items on delete cascade,
  shared_with_user uuid references profiles,
  invited_email citext,                                     -- pending until claimed
  permission share_perm not null,
  shared_by uuid not null references profiles, created_at timestamptz default now(),
  check (shared_with_user is not null or invited_email is not null)
);
create table vault_annotations (
  id uuid primary key default gen_random_uuid(),
  item_id uuid not null references vault_items on delete cascade,
  author_id uuid not null references profiles, anchor_snippet text, comment text not null,
  item_version int not null, status review_status not null default 'open',
  created_at timestamptz default now()
);
create table api_tokens (
  id uuid primary key default gen_random_uuid(),
  user_id uuid not null references profiles on delete cascade,
  org_id uuid references organizations,
  name text not null, prefix text not null,                 -- shown in UI, e.g. way_ab12
  token_hash text not null unique,                          -- SHA-256 of the full token; token shown once
  scopes text[] not null default '{vault:read}', expires_at timestamptz,
  last_used_at timestamptz, revoked_at timestamptz
);
create table audit_log (
  id bigint generated always as identity primary key,
  actor uuid, org_id uuid, action text not null, target text, meta jsonb,
  created_at timestamptz default now()
);
```

**RLS helpers** (SECURITY DEFINER avoids recursive policies):

```sql
create function is_org_member(o uuid) returns boolean language sql stable security definer
  set search_path = public as $$
  select exists (select 1 from organization_members where org_id = o and user_id = auth.uid()) $$;
create function org_role_of(o uuid) returns org_role language sql stable security definer
  set search_path = public as $$
  select role from organization_members where org_id = o and user_id = auth.uid() $$;
create function can_read_item(i uuid) returns boolean language sql stable security definer
  set search_path = public as $$
  select exists (select 1 from vault_items v where v.id = i and v.deleted_at is null and (
      v.owner_id = auth.uid()
      or (v.org_id is not null and is_org_member(v.org_id))
      or exists (select 1 from vault_shares s where s.item_id = v.id and s.shared_with_user = auth.uid()))) $$;
```

**Policies (intent; implement and test each)**
- `vault_items` SELECT: `can_read_item(id)`.
- INSERT: `owner_id = auth.uid()` and (`org_id is null` or `is_org_member(org_id)`).
- UPDATE: owner (personal), or org owner/admin or creator (org item), or an `edit` share. A trigger **rejects changes to `owner_id` and `org_id`** and bumps `version` / writes `vault_item_versions` (optimistic lock: update requires `version = old.version`).
- DELETE: owner, or org owner/admin → soft delete only.
- `vault_shares`: SELECT for the item owner, the recipient, and org admins; INSERT/DELETE for the item owner or an org admin. Edit-sharees **cannot re-share**.
- `organization_members`: SELECT for members of the same org; writes only through RPCs (`invite`, `accept_invite`, `set_role`, `remove_member`, `transfer_ownership`) that enforce the last-owner rule and write `audit_log`.
- `claim_pending_shares()`: run after sign-in; matches `invited_email` only if `auth.jwt()->>'email_verified'` is true.
- `api_tokens`: owner-only; the Edge Function reads by `token_hash` using a narrow SECURITY DEFINER function, never the service role with user input.
- Retention jobs (pg_cron): purge soft-deleted items after 30 days; purge `audit_log` after 1 year.

